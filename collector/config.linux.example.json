{
  "comment": "Linux (Ubuntu/Debian) collector config. install-collector-linux.sh writes it to /etc/lab-monitor/collector.json (mode 0640 root:labmon). 'volumes' is left out on purpose: real filesystems are discovered from the mount table.",
  "name": "compute-01",
  "id": "linux-compute-01",
  "device_type": "Server",
  "platform": "linux",
  "manager_url": "http://atlantis.med.harvard.edu:5000",
  "manager_token": "YOUR-COLLECTOR-TOKEN-FOR-THIS-DEVICE",

  "scan_paths": [
    "/home/*",
    "/data/*"
  ],
  "include_network_mounts": false,
  "cross_filesystems": false,

  "data_dir": "/var/lib/lab-monitor",
  "log_file": "/var/log/lab-monitor/collector.log",
  "log_level": "INFO",
  "timeout_seconds": 3600,
  "total_timeout_seconds": 10800,
  "request_timeout_seconds": 30,
  "max_batch_messages": 100,
  "max_queue_messages": 50000,
  "exclude_system_accounts": true,
  "exclude_users": [],

  "perf_counters": true,
  "counter_max_window_seconds": 86400,
  "user_metrics": "auto",
  "user_metrics_min_cores": 0.02,
  "user_metrics_min_ram_bytes": 1073741824,
  "user_cpu_count_children": true,
  "disk_io": true,
  "disk_io_exclude": [],
  "gpu_per_user": "auto",
  "metrics_interval_seconds": 300,

  "sessions": {
    "enabled": true,
    "detail": "full",
    "history": "changes",
    "list_heartbeat_seconds": 3600,
    "max_entries": 200,
    "ports": null,
    "extra_ports": {},
    "exclude_clients": [],
    "timeout_seconds": 20
  },
  "storage_health": {
    "enabled": true,
    "interval_seconds": 3600,
    "timeout_seconds": 90,
    "temperature_c": {"hdd": [50, 60], "ssd": [70, 80]},
    "ignore": []
  },
  "storage_breakdown": {
    "enabled": true,
    "owners": "file",
    "top_owners": 10,
    "device_top_owners": 25,
    "max_rows": 5000,
    "cold_days": [365, 1095],
    "name_lookup_budget_seconds": 30,
    "max_timeout_fraction": 0.6
  }
}
