# Lab Monitor collector: disk usage (volume capacity + folder sizes of scan_paths).
# Installed to /etc/systemd/system by install-collector-linux.sh; started daily
# by lab-monitor-disk.timer. Local overrides belong in a drop-in:
#   sudo systemctl edit lab-monitor-disk.service
[Unit]
Description=Lab Monitor collector - disk usage
Documentation=file:///opt/lab-monitor/collector/README.md

[Service]
Type=oneshot
User=labmon
Group=labmon
WorkingDirectory=/var/lib/lab-monitor
# -s / PYTHONNOUSERSITE: no user site-packages. HOME is labmon's writable
# /var/lib/lab-monitor, and a venv with system site-packages (the installer's
# offline fallback) would otherwise run any .pth file put under
# $HOME/.local - in the disk unit, with CAP_DAC_READ_SEARCH.
# --no-sync: archive and queue the result only. This unit has no network (see
# below); the next metrics run, which has no capabilities, sends the queue.
ExecStart=/opt/lab-monitor/venv/bin/python -s /opt/lab-monitor/collector/collector.py --config /etc/lab-monitor/collector.json --mode disk --no-sync
SyslogIdentifier=lab-monitor-disk
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
# The collector stops scanning after total_timeout_seconds (10800 s = 3 h in
# the installer's config) and then reports what it has; 1 h more covers volume
# capacity. install-collector-linux.sh rewrites this value from
# the config in lab-monitor-disk.service.d/50-timeout.conf on every run.
TimeoutStartSec=4h
UMask=0027
StateDirectory=lab-monitor
StateDirectoryMode=0750
LogsDirectory=lab-monitor
LogsDirectoryMode=0750

# Background priority: never compete with users for CPU or disk
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle

# --- Sandboxing ---------------------------------------------------------------
# Must list and stat every folder under scan_paths, whoever owns it, without
# being root (home folders are 0750 on Ubuntu). Linux has no permission for
# "list and stat, but don't open": CAP_DAC_READ_SEARCH, the smallest grant
# that does it, also lets the process read file contents. The scanner never
# opens a file it measures (scandir + lstat only), but the capability doesn't
# enforce that. So this unit is contained instead: no network at all, nothing
# writable outside its own data and log folders, and the system's own
# secrets hidden. It is the only capability this service can ever hold, and
# it grants no write access.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
# No network: an empty network namespace (loopback only), no IP sockets, and
# no IP traffic even if one were opened. AF_UNIX stays for the journal and
# user/group name lookups.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# Never scanned, and of no use to a disk scan: password hashes, SSH host keys,
# sudo rules, root's home folder. ('-': fine if one doesn't exist.)
InaccessiblePaths=-/root -/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/ssh -/etc/sudoers -/etc/sudoers.d
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lab-monitor /var/log/lab-monitor
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
