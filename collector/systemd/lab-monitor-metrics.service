# Lab Monitor collector: system metrics (CPU, RAM, uptime, network, GPUs, per-user).
# Installed to /etc/systemd/system by install-collector-linux.sh; started every
# 5 minutes by lab-monitor-metrics.timer. Local overrides belong in a drop-in:
#   sudo systemctl edit lab-monitor-metrics.service
[Unit]
Description=Lab Monitor collector - system metrics
Documentation=file:///opt/lab-monitor/collector/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=labmon
Group=labmon
WorkingDirectory=/var/lib/lab-monitor
# -s / PYTHONNOUSERSITE: no user site-packages. HOME is labmon's writable
# /var/lib/lab-monitor, and a venv with system site-packages (the installer's
# offline fallback) would otherwise run any .pth file put under
# $HOME/.local - in the disk unit, with CAP_DAC_READ_SEARCH.
ExecStart=/opt/lab-monitor/venv/bin/python -s /opt/lab-monitor/collector/collector.py --config /etc/lab-monitor/collector.json --mode metrics
SyslogIdentifier=lab-monitor-metrics
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
# A run takes a few seconds; a backlog after an outage is sent in batches.
# Well below the 5-minute interval: a hung run must not swallow the next one.
TimeoutStartSec=4min
UMask=0027
StateDirectory=lab-monitor
StateDirectoryMode=0750
LogsDirectory=lab-monitor
LogsDirectoryMode=0750

# --- Sandboxing ---------------------------------------------------------------
# Reads /proc for every user's processes (per-user metrics), so no
# ProtectProc=invisible / ProcSubset=pid, and no PrivateUsers= (it would show
# every other user as 'nobody'). ProcSubset=pid would also hide
# /proc/driver/nvidia, which NVML reads. No capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lab-monitor /var/log/lab-monitor
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# psutil reads /proc/net/dev for counters (no netlink); requests needs
# IPv4/IPv6, name resolution needs AF_UNIX (nscd, systemd-resolved), and so
# does NVML (the nvidia-persistenced socket).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Network: the Manager only. Everything is denied here; the installer's
# drop-in lab-monitor-metrics.service.d/50-network.conf allows the addresses
# manager_url resolves to (and the name servers), so without it this unit
# reaches nothing: a missing drop-in fails closed. Loopback stays open for the
# local resolver (systemd-resolved, 127.0.0.53).
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Covers what libnvidia-ml calls (ioctl, mmap, sched_*affinity, the NUMA calls
# mbind/set_mempolicy/get_mempolicy/move_pages in @resources, fork+exec of
# nvidia-modprobe); of its imports only iopl() is outside it, and that needs
# CAP_SYS_RAWIO anyway. A filtered call fails with EPERM instead of killing.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# --- NVIDIA GPUs (NVML, nvidia-ml-py) ------------------------------------------
# NVML opens /dev/nvidiactl, /dev/nvidia0..N (and /dev/nvidia-caps/*,
# /dev/nvidia-nvswitch* where present) and loads the driver's libnvidia-ml.so.1
# from wherever ldconfig finds it (read-only under ProtectSystem=strict, which
# leaves /dev alone). So, unlike the disk unit, this unit restricts no devices:
#  - no PrivateDevices=yes: it hides every /dev/nvidia* node;
#  - no DevicePolicy=closed/strict and no DeviceAllow=: any DeviceAllow= entry
#    blocks every device it doesn't list;
#  - no ProtectClock=yes: on systemd < 252 (Ubuntu 22.04 ships 249) it adds an
#    implicit "DeviceAllow=char-rtc r", which blocks /dev/nvidia* just the same
#    (systemd commit 63857bf, issue #18142). Without capabilities the service
#    can't set the clock anyway.
# To restrict devices in a drop-in, allow the NVIDIA majors too: the pattern
# matches every "nvidia*" name in /proc/devices (nvidia, nvidiactl, nvidia-uvm,
# nvidia-caps, ...; older drivers: nvidia-frontend):
#   DevicePolicy=closed
#   DeviceAllow=char-nvidia* rw
# NoNewPrivileges=yes means NVML can't use the setuid nvidia-modprobe to create
# missing device nodes: they must exist (nvidia-persistenced creates them at boot).
#
# MemoryDenyWriteExecute= stays off here (it is on in the disk unit). The
# driver's libnvidia-ml (checked: 470 and 580 builds) has no executable stack,
# text relocations or W+X segments and only mprotect()s to read-only, but
# NVIDIA doesn't document it as W^X-safe, some of its mmap() protections are
# computed at run time, and it can load libcuda.so.1. That couldn't be verified
# without a GPU, and for a Python service the setting adds little: an attacker
# running Python code doesn't need W+X memory. Working GPU stats win.
MemoryDenyWriteExecute=no
