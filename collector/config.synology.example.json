{
  "name": "Triton",
  "id": "synology-triton",
  "device_type": "NAS",
  "manager_url": "http://atlantis.med.harvard.edu:5000",
  "manager_token": "YOUR-COLLECTOR-TOKEN-FOR-THIS-DEVICE",

  "volumes": ["/volume1", "/volume2"],

  "scan_paths": [
    "/volume1/*",
    "/volume2/*"
  ],

  "data_dir": "/volume1/lab-monitor/data",
  "log_file": "/volume1/lab-monitor/logs/collector.log",
  "log_level": "INFO",
  "timeout_seconds": 3600,
  "total_timeout_seconds": 10800,
  "request_timeout_seconds": 30,
  "max_batch_messages": 100,
  "max_queue_messages": 50000,
  "exclude_users": [],

  "perf_counters": true,
  "counter_max_window_seconds": 86400,
  "user_metrics": "auto",
  "user_metrics_min_cores": 0.02,
  "user_metrics_min_ram_bytes": 1073741824,
  "user_cpu_count_children": true,
  "disk_io": true,
  "disk_io_exclude": [],

  "sessions": {
    "enabled": true,
    "detail": "full",
    "history": "changes",
    "list_heartbeat_seconds": 3600,
    "max_entries": 200,
    "ports": null,
    "extra_ports": {},
    "exclude_clients": [],
    "timeout_seconds": 20
  },
  "storage_health": {
    "enabled": true,
    "interval_seconds": 3600,
    "timeout_seconds": 90,
    "temperature_c": {"hdd": [50, 60], "ssd": [70, 80]},
    "ignore": []
  },
  "storage_breakdown": {
    "enabled": true,
    "owners": "file",
    "top_owners": 10,
    "device_top_owners": 25,
    "max_rows": 5000,
    "cold_days": [365, 1095],
    "name_lookup_budget_seconds": 30,
    "max_timeout_fraction": 0.6
  }
}
